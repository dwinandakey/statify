digraph G {
  rankdir=TB; nodesep=0.35; ranksep=0.38;
  node [fontname="Helvetica", fontsize=10, margin="0.08,0.04"];
  edge [fontname="Helvetica", fontsize=9];
  labelloc=t; label="WB-1 validateColumnPrefix"; fontsize=12; fontname="Helvetica-Bold";
  "S" [label="Mulai", shape=ellipse,style=filled,fillcolor="#d9ead3"];
  "p1" [label="1: trim().length = 0?", shape=diamond,style=filled,fillcolor="#fff2cc"];
  "r1" [label="2: return 'empty'", shape=box,style=filled,fillcolor="#f4cccc"];
  "p2" [label="3: prefix != trim()?", shape=diamond,style=filled,fillcolor="#fff2cc"];
  "p3" [label="4: /\\s/.test?", shape=diamond,style=filled,fillcolor="#fff2cc"];
  "r2" [label="5: return 'spaces'", shape=box,style=filled,fillcolor="#f4cccc"];
  "p4" [label="6: length > 32?", shape=diamond,style=filled,fillcolor="#fff2cc"];
  "r3" [label="7: return 'at most 32'", shape=box,style=filled,fillcolor="#f4cccc"];
  "p5" [label="8: bukan ^[A-Za-z@#$]?", shape=diamond,style=filled,fillcolor="#fff2cc"];
  "r4" [label="9: return 'must start'", shape=box,style=filled,fillcolor="#f4cccc"];
  "p6" [label="10: bukan ^[A-Za-z0-9._@#$]+$?", shape=diamond,style=filled,fillcolor="#fff2cc"];
  "r5" [label="11: return 'can only contain'", shape=box,style=filled,fillcolor="#f4cccc"];
  "r6" [label="12: return null", shape=box,style=filled,fillcolor="#cfe2f3"];
  "X" [label="Selesai", shape=ellipse,style=filled,fillcolor="#d9ead3"];
  "S" -> "p1";
  "p1" -> "r1" [label="T"];
  "p1" -> "p2" [label="F"];
  "p2" -> "r2" [label="T"];
  "p2" -> "p3" [label="F"];
  "p3" -> "r2" [label="T"];
  "p3" -> "p4" [label="F"];
  "p4" -> "r3" [label="T"];
  "p4" -> "p5" [label="F"];
  "p5" -> "r4" [label="T"];
  "p5" -> "p6" [label="F"];
  "p6" -> "r5" [label="T"];
  "p6" -> "r6" [label="F"];
  "r1" -> "X";
  "r2" -> "X";
  "r3" -> "X";
  "r4" -> "X";
  "r5" -> "X";
  "r6" -> "X";
}
